<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_shipping_label_document">
        <html>
            <head>
                <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
                <meta charset="utf-8"/>
                <style>
                    body {
                        margin: 0;
                    }
                    .label_page {
                        font-family: 'Khmer OS', 'Noto Sans Khmer', 'Helvetica Neue', Arial, sans-serif;
                        color: #1a1a2e;
                        padding: 0;
                        page-break-after: always;
                    }
                    .label_page:last-child {
                        page-break-after: avoid;
                    }
                    .label_header {
                        background: -webkit-linear-gradient(135deg, #6C5CE7 0%, #FD79A8 100%);
                        background: linear-gradient(135deg, #6C5CE7 0%, #FD79A8 100%);
                        border-radius: 10px;
                        text-align: center;
                        padding: 8px 6px;
                        margin-bottom: 8px;
                        color: #ffffff;
                    }
                    .label_header .logo_badge {
                        background: #ffffff;
                        border-radius: 8px;
                        display: inline-block;
                        padding: 3px 8px;
                        margin-bottom: 3px;
                    }
                    .label_header .company_logo {
                        max-width: 100%;
                        max-height: 14mm;
                        display: block;
                    }
                    .label_header .company_name {
                        font-size: 12pt;
                        font-weight: 800;
                        line-height: 1.2;
                    }
                    .label_header .company_meta {
                        font-size: 7.5pt;
                        opacity: 0.9;
                        line-height: 1.3;
                    }
                    .label_body .ship_to_label {
                        display: inline-block;
                        font-size: 7pt;
                        font-weight: 700;
                        letter-spacing: 1px;
                        text-transform: uppercase;
                        color: #ffffff;
                        background: #6C5CE7;
                        border-radius: 20px;
                        padding: 2px 9px;
                        margin-bottom: 5px;
                    }
                    .label_body .customer_name {
                        font-size: 15pt;
                        font-weight: 800;
                        line-height: 1.25;
                        margin-bottom: 3px;
                        color: #1a1a2e;
                    }
                    .label_body .customer_phone {
                        font-size: 10pt;
                        font-weight: 700;
                        color: #FD79A8;
                        margin-bottom: 6px;
                    }
                    .label_body .address_card {
                        background: #F7F5FE;
                        border-left: 3px solid #6C5CE7;
                        border-radius: 6px;
                        padding: 6px 8px;
                    }
                    .label_body .customer_address {
                        font-size: 9.5pt;
                        line-height: 1.5;
                        color: #1a1a2e;
                    }
                    .label_thanks {
                        margin-top: 8px;
                        text-align: center;
                        padding: 5px 4px;
                        border-top: 1px dashed #d8d3f5;
                    }
                    .label_thanks .thanks_en {
                        font-size: 8.5pt;
                        font-weight: 800;
                        color: #6C5CE7;
                        line-height: 1.3;
                    }
                    .label_thanks .thanks_km {
                        font-size: 7.5pt;
                        font-weight: 400;
                        color: #555555;
                        line-height: 1.3;
                    }
                    .label_footer_bar {
                        margin-top: 8px;
                        height: 4px;
                        border-radius: 4px;
                        background: -webkit-linear-gradient(90deg, #6C5CE7 0%, #FD79A8 100%);
                        background: linear-gradient(90deg, #6C5CE7 0%, #FD79A8 100%);
                    }
                </style>
            </head>
            <body>
                <t t-foreach="docs" t-as="o">
                    <div class="label_page">
                        <div class="label_header">
                            <t t-if="o.company_id.logo">
                                <div class="logo_badge">
                                    <img t-att-src="image_data_uri(o.company_id.logo)" class="company_logo"/>
                                </div>
                            </t>
                            <div class="company_name"><span t-esc="o.company_id.name"/></div>
                            <div class="company_meta">
                                <span t-if="o.company_id.website" t-esc="o.company_id.website"/>
                                <span t-if="o.company_id.website and o.company_id.phone"> | </span>
                                <span t-if="o.company_id.phone" t-esc="o.company_id.phone"/>
                            </div>
                        </div>

                        <div class="label_body">
                            <div class="ship_to_label">Deliver To</div>
                            <div class="customer_name"><span t-esc="o.partner_id.name"/></div>
                            <div class="customer_phone">
                                <span t-esc="o.partner_id.phone or o.partner_id.mobile or ''"/>
                            </div>
                            <div class="address_card">
                                <div class="customer_address">
                                    <span t-if="o.partner_id.street" t-esc="o.partner_id.street"/>
                                    <t t-if="o.partner_id.street"><br/></t>
                                    <span t-if="o.partner_id.street2" t-esc="o.partner_id.street2"/>
                                    <t t-if="o.partner_id.street2"><br/></t>
                                    <span t-if="o.partner_id.city" t-esc="o.partner_id.city"/>
                                    <span t-if="o.partner_id.city and o.partner_id.state_id">, </span>
                                    <span t-if="o.partner_id.state_id" t-esc="o.partner_id.state_id.name"/>
                                    <span t-if="o.partner_id.zip"> <t t-esc="o.partner_id.zip"/></span>
                                    <t t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip"><br/></t>
                                    <span t-if="o.partner_id.country_id" t-esc="o.partner_id.country_id.name"/>
                                </div>
                            </div>
                        </div>

                        <div class="label_thanks">
                            <div class="thanks_en">Thank You For Your Order!</div>
                            <div class="thanks_km">សូមអរគុណសម្រាប់ការទិញឥវ៉ាន់របស់អ្នក!</div>
                        </div>

                        <div class="label_footer_bar"/>
                    </div>
                </t>
            </body>
        </html>
    </template>

</odoo>
