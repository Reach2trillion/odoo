<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_telegram" model="ir.module.category">
            <field name="name">Telegram</field>
            <field name="description">Access to Telegram marketing campaigns and customer chats.</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_telegram_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_telegram"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can read the Telegram inbox, answer customers and create campaigns.</field>
        </record>

        <record id="group_telegram_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_telegram"/>
            <field name="implied_ids" eval="[(4, ref('group_telegram_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Can configure bots (tokens, webhooks) and auto-reply rules.</field>
        </record>
    </data>

    <data noupdate="1">
        <record id="rule_telegram_bot_company" model="ir.rule">
            <field name="name">Telegram Bot: multi-company</field>
            <field name="model_id" ref="model_telegram_bot"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_telegram_chat_company" model="ir.rule">
            <field name="name">Telegram Chat: multi-company</field>
            <field name="model_id" ref="model_telegram_chat"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_telegram_message_company" model="ir.rule">
            <field name="name">Telegram Message: multi-company</field>
            <field name="model_id" ref="model_telegram_message"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_telegram_campaign_company" model="ir.rule">
            <field name="name">Telegram Campaign: multi-company</field>
            <field name="model_id" ref="model_telegram_campaign"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_telegram_auto_reply_company" model="ir.rule">
            <field name="name">Telegram Auto Reply: multi-company</field>
            <field name="model_id" ref="model_telegram_auto_reply"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
