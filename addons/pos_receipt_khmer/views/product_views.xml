<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- product form (also the variant form, which inherits it): the Khmer receipt name right under
         the product name. div.oe_title exists in this view on every 18.0 build. -->
    <record id="product_template_form_view_pos_receipt_khmer" model="ir.ui.view">
        <field name="name">product.template.form.pos_receipt_khmer</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <div class="o_kh_receipt_name d-flex align-items-baseline gap-2 mb-2">
                    <label for="kh_receipt_name" class="text-nowrap"/>
                    <field name="kh_receipt_name" class="w-100" placeholder="e.g. ឡេការពារកម្តៅថ្ងៃ"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view_pos_receipt_khmer" model="ir.ui.view">
        <field name="name">product.template.list.pos_receipt_khmer</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="kh_receipt_name" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Action menu of the product list and form; only for the groups that may write products
         (product.template write access), the others would get an access error -->
    <record id="action_kh_fill_receipt_name" model="ir.actions.server">
        <field name="name">Khmer receipt name: fill from Sales Description</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[Command.link(ref('product.group_product_manager')),
                                       Command.link(ref('point_of_sale.group_pos_manager')),
                                       Command.link(ref('sales_team.group_sale_manager')),
                                       Command.link(ref('stock.group_stock_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_kh_fill_receipt_name()</field>
    </record>
</odoo>
