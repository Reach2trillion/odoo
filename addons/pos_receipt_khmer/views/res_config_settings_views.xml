<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_receipt_khmer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos_receipt_khmer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                <setting id="kh_paper_width" string="Receipt paper" help="Paper width of this point of sale's receipt printer. Reload the POS (or reopen the session) to apply.">
                    <field name="pos_kh_paper_width" widget="radio" options="{'horizontal': true}"/>
                    <field name="kh_pos_has_receipt_logo" invisible="1"/>
                    <div class="content-group mt8" invisible="pos_kh_paper_width != '58'">
                        <label for="pos_kh_raster_dots" string="Print width (dots)" class="o_light_label me-2"/>
                        <field name="pos_kh_raster_dots" class="oe_inline"/>
                    </div>
                    <div class="alert alert-warning mt8 mb-0" role="alert"
                         invisible="pos_kh_paper_width != '58' or kh_pos_has_receipt_logo">
                        58 mm receipts need the company's thermal receipt logo (1-bit, 200 px wide;
                        Settings > Companies > POS Receipt (Khmer)). Without it, the company logo
                        prints with broken lines.
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
