<?xml version="1.0" encoding="UTF-8"?>
<!--
    Khmer / English receipt: extensions only (never primary, never replace). Every node is a
    restyled core node or a new kh-* node inserted next to a class anchor, so pos_loyalty,
    pos_sale, l10n_* and other extenders keep finding their anchors.
    Khmer and bilingual nodes carry t-translation="off": the receipt must not depend on km.po
    or on the cashier's UI language.
    Every xpath must resolve on every 18.0 build (an unresolved xpath throws and no receipt renders
    at all). Anchors that only exist on some builds are written "<anchor> | <sink>": the union
    resolves to the real node when it exists (it comes first in document order) and otherwise to
    span.kh-xp-sink, a node inside <t t-if="false"> appended at the end of the receipt, where the
    change is harmless and never rendered.
    No &#160; in static text: OWL's template compiler turns every whitespace run of a static text
    node into one plain space, NBSP included (JS \s). Groups that must not break are wrapped in
    span.kh-nw (white-space: nowrap); NBSP and WORD JOINER only survive in t-esc data.
-->
<templates id="template" xml:space="preserve">

<!-- ReceiptHeader: also rendered by CashMoveReceipt (no order) -->
<t t-name="pos_receipt_khmer.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
    <xpath expr="//img[hasclass('pos-receipt-logo')]" position="attributes">
        <attribute name="t-attf-src">/web/image?model=res.company&amp;id={{props.data.company.id}}&amp;field={{props.data.kh?.logo_field or 'logo'}}</attribute>
        <attribute name="t-att-class">{'kh-logo-print': props.data.kh?.logo_field === 'kh_receipt_logo'}</attribute>
    </xpath>
    <xpath expr="//div[hasclass('pos-receipt-contact')]/.." position="attributes">
        <attribute name="class" add="kh-head" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('pos-receipt-contact')]" position="before">
        <div t-if="props.data.kh" class="kh-brand" t-translation="off">
            <div t-if="props.data.kh.name_km" class="kh-brand-km" t-esc="props.data.kh.name_km"/>
            <div t-if="props.data.company.name" class="kh-brand-en" t-esc="props.data.company.name"/>
            <div t-if="props.data.kh.addr_km" class="kh-brand-addr" t-esc="props.data.kh.addr_km"/>
            <div t-if="props.data.kh.addr_en" class="kh-brand-addr kh-latin" t-esc="props.data.kh.addr_en"/>
        </div>
        <div t-if="props.data.kh" class="kh-contact" t-translation="off">
            <div t-if="props.data.kh.phone">ទូរស័ព្ទ / Tel <span class="kh-nw" t-esc="props.data.kh.phone"/></div>
            <div t-if="props.data.kh.web_line" class="kh-latin" t-esc="props.data.kh.web_line"/>
            <div t-if="props.data.kh.tin_line" t-esc="props.data.kh.tin_line"/>
        </div>
    </xpath>
</t>

<t t-name="pos_receipt_khmer.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
    <!-- sink for the optional anchors (see the header comment); must stay the first operation -->
    <xpath expr="//div[hasclass('pos-receipt')]" position="inside">
        <t t-if="false"><span class="kh-xp-sink"/></t>
    </xpath>
    <!-- root classes only when the Khmer data exists: if it could not be built, no receipt CSS
         applies and the core receipt prints unchanged. 58 mm paper (pos.config.kh_paper_width): the
         o_kh_w58 layer, and the raster width in dots as a custom property (no style attribute on 80 mm).
         Without the Khmer data, kh_paper still carries the paper: the core receipt is then only scaled
         to the 58 mm raster width (o_kh_w58 without o_kh_receipt, see the stylesheet). -->
    <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
        <attribute name="t-att-class">{'o_kh_receipt': props.data.kh, 'o_kh_unpaid': props.data.kh?.unpaid, 'o_kh_w58': (props.data.kh or props.data.kh_paper)?.paper === '58'}</attribute>
        <attribute name="t-att-style">(props.data.kh or props.data.kh_paper)?.raster_w ? '--kh-raster-w:' + (props.data.kh or props.data.kh_paper).raster_w + 'px' : false</attribute>
    </xpath>
    <!-- the total is the first div.pos-receipt-amount on every 18.0 build; core only added the
         receipt-total class in Nov 2024 (8fb7e5fd), so add it (once) for the anchors and CSS below -->
    <xpath expr="//div[hasclass('pos-receipt-amount')]" position="attributes">
        <attribute name="class" remove="receipt-total" add="receipt-total" separator=" "/>
    </xpath>
    <!-- band + meta -->
    <xpath expr="//ReceiptHeader" position="after">
        <div t-if="props.data.kh" class="kh-doc" t-translation="off">
            <div t-if="!props.data.kh.unpaid" class="kh-band">
                <span class="kh-band-km" t-esc="props.data.kh.title_km"/><span class="kh-band-en" t-esc="props.data.kh.title_en"/>
            </div>
            <div t-else="" class="kh-band kh-band--due">
                <span class="kh-band-km">មិន&#8203;ទាន់&#8203;បង់ប្រាក់</span>
                <span class="kh-band-en">NOT PAID — PRE-RECEIPT</span>
                <div class="kh-band-note"><span class="kh-nw" t-esc="props.data.kh.not_doc_km"/> / <span class="kh-nw" t-esc="props.data.kh.not_doc_en"/></div>
            </div>
            <div class="kh-meta">
                <div class="kh-row"><span t-esc="props.data.kh.number_label"/><b t-esc="props.data.kh.number"/></div>
                <div class="kh-row"><span>កាលបរិច្ឆេទ / Date</span><b t-esc="props.data.kh.date"/></div>
                <div t-if="props.data.cashier" class="kh-row"><span>អ្នកគិតលុយ / Cashier</span><b t-esc="props.data.cashier"/></div>
                <div t-if="props.data.kh.partner_name" class="kh-row"><span>អតិថិជន / Customer</span><b t-esc="props.data.kh.partner_name"/></div>
            </div>
        </div>
    </xpath>
    <!-- item lines: receipt-only rows in OrderReceipt's own <Orderline> slot (shared Orderline untouched) -->
    <xpath expr="//Orderline" position="inside">
        <t t-set="kl" t-value="khLine(line)"/>
        <li t-if="kl" class="kh-qty" t-translation="off"><t t-esc="kl.qty"/><t t-if="!props.basic_receipt"> × <t t-esc="kl.unit_price"/></t></li>
        <li t-if="kl and kl.disc_line and !props.basic_receipt" class="kh-disc" t-esc="kl.disc_line" t-translation="off"/>
    </xpath>
    <xpath expr="//li[hasclass('customer-note')]/i" position="after">
        <span class="kh-note-lbl" t-translation="off">សម្គាល់ / Note · </span>
    </xpath>
    <!-- amounts: receipt-only USD formatter (attribute change only; the spans stay as anchors).
         Every amount span gets it, so a refund prints "$-15.72" (Odoo's sign order, no NBSP)
         everywhere, never "$ -15.72". -->
    <xpath expr="//div[hasclass('receipt-total')]/span[hasclass('pos-receipt-right-align')]" position="attributes">
        <attribute name="t-esc">khUsd(khTotal())</attribute>
    </xpath>
    <!-- cash rounding (receipt-rounding / receipt-to-pay classes: Nov 2024 builds and later) -->
    <xpath expr="//div[hasclass('receipt-rounding')]/span[hasclass('pos-receipt-right-align')] | //span[hasclass('kh-xp-sink')]" position="attributes">
        <attribute name="t-esc">khUsd(khRounding())</attribute>
    </xpath>
    <xpath expr="//div[hasclass('receipt-to-pay')]/span[hasclass('pos-receipt-right-align')] | //span[hasclass('kh-xp-sink')]" position="attributes">
        <attribute name="t-esc">khUsd(khTotal() + khRounding())</attribute>
    </xpath>
    <xpath expr="//div[hasclass('receipt-to-pay')]/span[hasclass('pos-receipt-right-align')] | //span[hasclass('kh-xp-sink')]" position="before">
        <span t-if="props.data.kh" class="kh-topay-lbl" t-translation="off">ប្រាក់ត្រូវបង់ / To pay</span>
    </xpath>
    <!-- tax summary: only where the exact core expression is found, so the loop variables exist -->
    <xpath expr="//div[hasclass('pos-receipt-taxes')]//span[@t-esc='props.formatCurrency(subtotal.base_amount_currency)'] | //span[hasclass('kh-xp-sink')]" position="attributes">
        <attribute name="t-esc">khUsd(subtotal.base_amount_currency)</attribute>
    </xpath>
    <xpath expr="//div[hasclass('pos-receipt-taxes')]//span[@t-esc='props.formatCurrency(tax_group.base_amount_currency)'] | //span[hasclass('kh-xp-sink')]" position="attributes">
        <attribute name="t-esc">khUsd(tax_group.base_amount_currency)</attribute>
    </xpath>
    <xpath expr="//div[hasclass('pos-receipt-taxes')]//span[@t-esc='props.formatCurrency(tax_group.tax_amount_currency)'] | //span[hasclass('kh-xp-sink')]" position="attributes">
        <attribute name="t-esc">khUsd(tax_group.tax_amount_currency)</attribute>
    </xpath>
    <xpath expr="//div[hasclass('paymentlines')]/span[hasclass('pos-receipt-right-align')]" position="attributes">
        <attribute name="t-esc">khUsd(line.amount)</attribute>
    </xpath>
    <!-- change: visibility and amount come from the normalised data (export_for_printing), not from
         the build-specific core expressions ('order_change' in taxTotals / show_change) -->
    <xpath expr="//div[hasclass('receipt-change')]" position="attributes">
        <attribute name="t-if">props.data.show_change</attribute>
    </xpath>
    <xpath expr="//div[hasclass('receipt-change')]/span[hasclass('pos-receipt-right-align')]" position="attributes">
        <attribute name="t-esc">khUsd(props.data.order_change)</attribute>
    </xpath>
    <xpath expr="//div[hasclass('receipt-change')]/following::div[hasclass('text-center')][1]/span[hasclass('pos-receipt-right-align')]" position="attributes">
        <attribute name="t-esc">khUsd(props.data.total_discount)</attribute>
    </xpath>
    <!-- KHR total + rate -->
    <xpath expr="//div[hasclass('receipt-total')]" position="inside">
        <span t-if="props.data.kh?.total_khr" class="kh-amt-khr" t-translation="off"><t t-esc="props.data.kh.total_khr"/> <span class="kh-riel">៛</span></span>
    </xpath>
    <xpath expr="//div[hasclass('receipt-total')]" position="after">
        <div t-if="props.data.kh?.rate_text" class="kh-row kh-rate" t-translation="off"><span>អត្រាប្តូរប្រាក់ / Rate</span><b>1 <t t-esc="props.data.kh.rate_from"/> = <span class="kh-nw"><t t-esc="props.data.kh.rate_text"/> <span class="kh-riel">៛</span></span></b></div>
    </xpath>
    <!-- payments -->
    <xpath expr="//div[hasclass('paymentlines')]" position="before">
        <div t-if="props.data.paymentlines.length" class="kh-pay-head"/>
    </xpath>
    <xpath expr="//div[hasclass('paymentlines')]" position="inside">
        <div t-if="line.kh_txn" class="kh-txn" t-translation="off">លេខប្រតិបត្តិការ / Txn ID <t t-esc="line.kh_txn"/></div>
    </xpath>
    <xpath expr="//div[hasclass('receipt-change')]" position="before">
        <div t-if="props.data.kh?.due" class="kh-row" t-translation="off"><span>ប្រាក់នៅខ្វះ / Balance due</span><b t-esc="khUsd(props.data.kh.due)"/></div>
    </xpath>
    <xpath expr="//div[hasclass('receipt-change')]" position="inside">
        <span t-if="props.data.kh?.change_khr" class="kh-amt-khr" t-translation="off"><span class="kh-or">ឬ / or</span><t t-esc="props.data.kh.change_khr"/> <span class="kh-riel">៛</span></span>
        <span t-if="props.data.kh?.change_round" class="kh-round" t-translation="off"><span>ការបង្គត់ / Rounding</span><b class="kh-nw"><t t-esc="props.data.kh.change_round"/> <span class="kh-riel">៛</span></b></span>
    </xpath>
    <!-- loyalty: after pos_loyalty's own content (we depend on pos_loyalty) -->
    <xpath expr="//div[hasclass('before-footer')]" position="inside">
        <div t-if="props.data.kh?.loyalty?.length" class="kh-loyalty" t-translation="off">
            <t t-foreach="props.data.kh.loyalty" t-as="ls" t-key="ls_index">
                <!-- the program's name only when there is more than one program. A label never wraps
                     (on 58 mm a figure that does not fit beside it moves to its own line) -->
                <div t-if="props.data.kh.loyalty.length > 1 and ls.name" class="kh-loy-name" t-esc="ls.name"/>
                <div t-if="ls.won" class="kh-row"><span>ពិន្ទុទទួលបាន / <span class="kh-nw">Points earned</span></span><b t-esc="ls.won"/></div>
                <div t-if="ls.spent" class="kh-row"><span>ពិន្ទុបានប្រើ / <span class="kh-nw">Points spent</span></span><b t-esc="ls.spent"/></div>
                <div t-if="ls.balance" class="kh-row"><span>សមតុល្យពិន្ទុ / <span class="kh-nw">Points balance</span></span><b t-esc="ls.balance"/></div>
            </t>
        </div>
    </xpath>
    <!-- sign-off -->
    <xpath expr="//div[hasclass('after-footer')]" position="before">
        <div t-if="props.data.kh" class="kh-signoff" t-translation="off">
            <div class="kh-orn"/>
            <t t-if="!props.data.kh.unpaid">
                <div class="kh-thanks"><span class="kh-thanks-km">សូមអរគុណ</span><span class="kh-thanks-en">THANK YOU</span></div>
                <!-- the English half never breaks: on 58 mm the sentence breaks only after " / " -->
                <div class="kh-again">សូម&#8203;អញ្ជើញ&#8203;មក&#8203;ម្តង&#8203;ទៀត / <span class="kh-nw">Please come again</span></div>
            </t>
            <t t-else="">
                <div class="kh-again">សូម&#8203;បង់ប្រាក់&#8203;នៅ&#8203;បញ្ជរ / <span class="kh-nw">Please pay at the counter</span></div>
                <div class="kh-stamp">មិន&#8203;ទាន់&#8203;បង់ប្រាក់ · NOT PAID</div>
            </t>
        </div>
    </xpath>
</t>

<t t-name="pos_receipt_khmer.CashMoveReceipt" t-inherit="point_of_sale.CashMoveReceipt" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
        <attribute name="class" add="o_kh_receipt o_kh_cashmove" separator=" "/>
        <attribute name="t-att-class">{'o_kh_w58': props.headerData.kh?.paper === '58'}</attribute>
        <attribute name="t-att-style">props.headerData.kh?.raster_w ? '--kh-raster-w:' + props.headerData.kh.raster_w + 'px' : false</attribute>
    </xpath>
    <xpath expr="//div[hasclass('pos-receipt-center-align')]" position="before">
        <div class="kh-band" t-translation="off"><span class="kh-band-km" t-esc="khMove.km"/><span class="kh-band-en" t-esc="khMove.en"/></div>
        <div class="kh-meta" t-translation="off">
            <div class="kh-row kh-row--big"><span>ទឹកប្រាក់ / Amount</span><b t-esc="khMove.amount"/></div>
            <div t-if="props.reason" class="kh-row"><span>មូលហេតុ / Reason</span><b t-esc="props.reason"/></div>
            <div t-if="props.headerData.kh?.cashier_name" class="kh-row"><span>អ្នកគិតលុយ / Cashier</span><b t-esc="props.headerData.kh.cashier_name"/></div>
            <div class="kh-row"><span>កាលបរិច្ឆេទ / Date</span><b t-esc="khMove.date"/></div>
        </div>
    </xpath>
</t>
<!-- Optional 58 mm support for core's "Daily sales" report (not a customer document, no Khmer
     content): it is printed only through hardwareProxy.printer (ePOS / IoT) as a 512-dot image, which
     a 58 mm printer refuses or clips. On a 58 mm till the root gets o_kh_w58 and the raster width;
     the stylesheet scales the report (font-size = width x 27 / 512) instead of reflowing it. 80 mm:
     no class, no style attribute. -->
<t t-name="pos_receipt_khmer.SaleDetailsReport" t-inherit="point_of_sale.SaleDetailsReport" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
        <attribute name="t-att-class">{'o_kh_w58': pos?.config?.kh_paper_width === '58'}</attribute>
        <attribute name="t-att-style">pos?.config?.kh_paper_width === '58' ? '--kh-raster-w:' + (pos.config.kh_raster_dots || 384) + 'px' : false</attribute>
    </xpath>
</t>
</templates>
