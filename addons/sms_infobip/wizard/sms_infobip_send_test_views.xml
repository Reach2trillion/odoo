<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sms_infobip_send_test_view_form" model="ir.ui.view">
        <field name="name">sms_infobip.send.test.view.form</field>
        <field name="model">sms_infobip.send.test</field>
        <field name="arch" type="xml">
            <form string="Send Test SMS via Infobip">
                <group>
                    <field name="number" placeholder="+855 12 345 678"/>
                    <field name="body"/>
                </group>
                <footer>
                    <button string="Send" name="action_send" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
