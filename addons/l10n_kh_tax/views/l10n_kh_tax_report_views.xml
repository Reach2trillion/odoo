<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_kh_tax_report_list" model="ir.ui.view">
        <field name="name">l10n.kh.tax.report.list</field>
        <field name="model">l10n.kh.tax.report</field>
        <field name="arch" type="xml">
            <list string="Monthly Tax Declarations">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="turnover"/>
                <field name="total_tax_amount"/>
                <field name="total_tax_amount_khr" optional="hide"/>
                <field name="filed_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'filed'"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_kh_tax_report_form" model="ir.ui.view">
        <field name="name">l10n.kh.tax.report.form</field>
        <field name="model">l10n.kh.tax.report</field>
        <field name="arch" type="xml">
            <form string="Monthly Tax Declaration">
                <header>
                    <button name="action_compute" type="object" string="Compute"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="l10n_kh_tax.group_l10n_kh_tax_manager"/>
                    <button name="action_export_efiling" type="object"
                            string="Export e-Filing (Excel)"
                            invisible="state == 'draft'"/>
                    <button name="action_mark_filed" type="object"
                            string="Mark as Filed"
                            class="btn-success" invisible="state != 'confirmed'"
                            groups="l10n_kh_tax.group_l10n_kh_tax_manager"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft" invisible="state == 'draft'"
                            groups="l10n_kh_tax.group_l10n_kh_tax_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,filed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Period">
                            <field name="month" readonly="state != 'draft'"/>
                            <field name="year" readonly="state != 'draft'"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Company / Filing">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="exchange_rate" readonly="state != 'draft'"/>
                            <field name="filed_date"/>
                            <field name="filed_by_id"/>
                            <field name="efiling_attachment_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Totals">
                            <field name="turnover"/>
                            <field name="total_tax_amount"/>
                            <field name="total_tax_amount_khr"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Declaration Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="code"/>
                                    <field name="section"/>
                                    <field name="name"/>
                                    <field name="base_amount"/>
                                    <field name="tax_amount"/>
                                    <field name="amount_khr"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Audit Notes" name="audit">
                            <field name="note"
                                   placeholder="Remarks for the tax auditor: adjustments, reconciliation with the GDT e-Filing portal, penalties, ..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_l10n_kh_tax_report_search" model="ir.ui.view">
        <field name="name">l10n.kh.tax.report.search</field>
        <field name="model">l10n.kh.tax.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="year"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Filed" name="filed" domain="[('state', '=', 'filed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Year" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_kh_tax_report" model="ir.actions.act_window">
        <field name="name">Monthly Tax Declarations</field>
        <field name="res_model">l10n.kh.tax.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_kh_tax_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first GDT monthly tax declaration
            </p>
            <p>
                A declaration is generated automatically at the beginning of each
                month for the previous month. You can also create one manually,
                press <b>Compute</b> to fill it from the accounting entries, then
                <b>Confirm</b>, export the <b>e-Filing</b> file and mark it as
                <b>Filed</b> once submitted on the GDT portal.
            </p>
        </field>
    </record>
</odoo>
