<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_kh" model="ir.ui.view">
        <field name="name">account.move.form.l10n.kh</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group>
                    <group string="Cambodia Tax (GDT)" name="l10n_kh_tax">
                        <field name="l10n_kh_exclude_tax_report"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
