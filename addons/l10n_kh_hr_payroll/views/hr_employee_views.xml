<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_l10n_kh" model="ir.ui.view">
        <field name="name">hr.employee.form.l10n.kh</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group string="Cambodia (កម្ពុជា)" name="l10n_kh">
                    <group>
                        <field name="l10n_kh_khmer_name"/>
                        <field name="l10n_kh_nssf_id"/>
                    </group>
                    <group>
                        <field name="l10n_kh_tax_resident"/>
                        <field name="l10n_kh_tax_dependents"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
