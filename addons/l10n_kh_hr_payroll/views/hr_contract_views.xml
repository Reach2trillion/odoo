<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_contract_view_form_l10n_kh" model="ir.ui.view">
        <field name="name">hr.contract.form.l10n.kh</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cambodia (កម្ពុជា)" name="l10n_kh">
                    <group>
                        <group string="Monthly Allowances" name="l10n_kh_allowances">
                            <field name="l10n_kh_housing_allowance"/>
                            <field name="l10n_kh_transport_allowance"/>
                            <field name="l10n_kh_meal_allowance"/>
                            <field name="l10n_kh_phone_allowance"/>
                            <field name="l10n_kh_other_allowance"/>
                            <field name="l10n_kh_nontaxable_allowance"/>
                        </group>
                        <group string="Contract Terms" name="l10n_kh_terms">
                            <field name="l10n_kh_contract_duration"/>
                            <field name="l10n_kh_workplace"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
