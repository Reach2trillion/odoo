<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_payslip_kh" model="ir.actions.report">
        <field name="name">Payslip (Khmer) បង្កាន់ដៃប្រាក់បៀវត្ស</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_kh_hr_payroll.report_payslip_kh</field>
        <field name="report_file">l10n_kh_hr_payroll.report_payslip_kh</field>
        <field name="print_report_name">'Payslip - %s - %s' % (object.employee_id.name, object.date_to)</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_contract_kh" model="ir.actions.report">
        <field name="name">Employment Contract (Khmer) កិច្ចសន្យាការងារ</field>
        <field name="model">hr.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_kh_hr_payroll.report_contract_kh</field>
        <field name="report_file">l10n_kh_hr_payroll.report_contract_kh</field>
        <field name="print_report_name">'Employment Contract - %s' % (object.employee_id.name or object.name)</field>
        <field name="binding_model_id" ref="hr_contract.model_hr_contract"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
