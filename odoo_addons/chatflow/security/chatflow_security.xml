<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_chatflow" model="ir.module.category">
        <field name="name">ChatFlow</field>
        <field name="description">Messenger marketing automation</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_chatflow_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_chatflow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_chatflow_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_chatflow"/>
        <field name="implied_ids" eval="[(4, ref('group_chatflow_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_chatflow_manager'))]"/>
    </record>
</odoo>
