<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_account_report_a4" model="report.paperformat">
        <field name="name">Accounting Report A4</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_account_daily" model="ir.actions.report">
        <field name="name">Daily Accounting Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_daily_report_telegram.report_account_daily_document</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="account_daily_report_telegram.paperformat_account_report_a4"/>
    </record>

    <record id="action_report_account_weekly" model="ir.actions.report">
        <field name="name">Weekly Accounting Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_daily_report_telegram.report_account_weekly_document</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="account_daily_report_telegram.paperformat_account_report_a4"/>
    </record>

    <record id="action_report_account_monthly" model="ir.actions.report">
        <field name="name">Monthly Accounting Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_daily_report_telegram.report_account_monthly_document</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="account_daily_report_telegram.paperformat_account_report_a4"/>
    </record>

</odoo>
