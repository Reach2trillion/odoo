<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_purchase_order_form_telegram" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.telegram</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Telegram button in header after all existing buttons -->
            <xpath expr="//header/button[@name='action_rfq_send'][1]" position="after">
                <button name="action_send_telegram" 
                        type="object" 
                        string="Send by Telegram" 
                        icon="fa-telegram"
                        invisible="state not in ('draft', 'sent', 'purchase')"/>
            </xpath>
        </field>
    </record>
    
</odoo>
