<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_sale_daily_report" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.daily.report.telegram</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Daily Sales Report" string="Daily Sales Report"
                     name="sale_daily_report_telegram">
                    <block title="Daily, Weekly &amp; Monthly Sales Report" name="sale_daily_report_telegram_setting_container">
                        <setting id="sale_daily_report_telegram_enabled_setting"
                                 string="Send Daily Sales Report"
                                 help="Send a daily PDF summary of confirmed sales orders via Telegram">
                            <field name="sale_daily_report_telegram_enabled"/>
                        </setting>
                        <setting id="sale_daily_report_telegram_weekly_enabled_setting"
                                 string="Send Weekly Sales Report"
                                 help="Send a weekly PDF summary (every Monday, covering the previous Mon-Sun week) of confirmed sales orders via Telegram">
                            <field name="sale_daily_report_telegram_weekly_enabled"/>
                        </setting>
                        <setting id="sale_daily_report_telegram_monthly_enabled_setting"
                                 string="Send Monthly Sales Report"
                                 help="Send a monthly PDF summary (1st of each month, covering the previous month) of confirmed sales orders via Telegram">
                            <field name="sale_daily_report_telegram_monthly_enabled"/>
                        </setting>
                        <setting id="sale_daily_report_telegram_chat_id_setting"
                                 string="Telegram Chat ID"
                                 help="Telegram chat ID(s) that receive the daily sales PDF report, comma-separated for multiple recipients (e.g. one boss's chat, one for another). The bot token itself is configured in the Send by Telegram settings.">
                            <field name="sale_daily_report_telegram_chat_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
