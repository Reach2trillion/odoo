<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 12:00 UTC = 19:00 Indochina Time (UTC+7) -->
    <record id="ir_cron_daily_sales_report_telegram" model="ir.cron">
        <field name="name">Send Daily Sales Report via Telegram</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_daily_sales_report_telegram()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="'2024-01-01 12:00:00'"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="active">True</field>
    </record>

    <!-- 12:15 UTC every Monday = 19:15 Indochina Time (UTC+7); reports on the previous Mon-Sun week -->
    <record id="ir_cron_weekly_sales_report_telegram" model="ir.cron">
        <field name="name">Send Weekly Sales Report via Telegram</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_weekly_sales_report_telegram()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="nextcall" eval="'2024-01-08 12:15:00'"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="active">True</field>
    </record>

    <!-- 00:45 UTC on the 1st = 07:45 Indochina Time (UTC+7); reports on the previous month -->
    <record id="ir_cron_monthly_sales_report_telegram" model="ir.cron">
        <field name="name">Send Monthly Sales Report via Telegram</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_monthly_sales_report_telegram()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="nextcall" eval="'2024-02-01 00:45:00'"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="active">True</field>
    </record>

</odoo>
