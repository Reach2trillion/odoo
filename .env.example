# Facebook Page access token (Meta for Developers > your app > Messenger > Access Tokens)
PAGE_ACCESS_TOKEN=your-page-access-token

# Any secret string you choose; enter the same value when configuring the webhook
VERIFY_TOKEN=choose-a-secret-verify-token

# App secret (Meta for Developers > App settings > Basic). Optional but recommended:
# when set, webhook payload signatures are verified.
APP_SECRET=

# Graph API version to call
GRAPH_API_VERSION=v21.0

# Text-to-speech language (km = Khmer)
TTS_LANG=km

# Also send the reply as text next to the voice message (true/false)
SEND_TEXT_WITH_VOICE=true

# Also auto-reply (text) to comments on the Page's posts (true/false)
REPLY_TO_COMMENTS=true
