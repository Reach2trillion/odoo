<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Log in with Telegram" on the login page -->
    <template id="telegram_login_button" inherit_id="web.login" name="Telegram Login Button">
        <xpath expr="//div[hasclass('o_login_auth')]" position="inside">
            <t t-if="telegram_login_url or telegram_bot_username">
                <em class="d-block text-center text-muted small my-2">- or -</em>
            </t>
            <!-- chat / OpenID Connect flow: plain server-side redirect -->
            <t t-if="telegram_login_url">
                <a t-att-href="telegram_login_url" role="button"
                   class="btn w-100 text-white fw-bold"
                   style="background-color: #54a9eb;">
                    <i class="fa fa-paper-plane me-2" role="img" aria-label="Telegram"/>Log in with Telegram
                </a>
            </t>
            <!-- legacy Login Widget flow -->
            <t t-elif="telegram_bot_username">
                <div class="o_auth_telegram d-flex justify-content-center pt-1">
                    <script async="async"
                            src="https://telegram.org/js/telegram-widget.js?22"
                            t-att-data-telegram-login="telegram_bot_username"
                            data-size="large"
                            data-userpic="false"
                            t-att-data-auth-url="telegram_auth_url"
                            data-request-access="write"/>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Page where a logged-in user links / unlinks their own Telegram account -->
    <template id="link_account_page" name="Link Telegram Account">
        <t t-call="web.login_layout">
            <div class="text-center">
                <h5 class="mb-3">Telegram account</h5>
                <div t-if="link_error == 'taken'" class="alert alert-danger" role="alert">
                    This Telegram account is already linked to another user.
                </div>
                <div t-elif="link_error == 'password'" class="alert alert-danger" role="alert">
                    Incorrect password, please try again.
                </div>
                <div t-elif="link_error == 'reauth'" class="alert alert-warning" role="alert">
                    Please confirm it is you first by logging in with your Telegram account again.
                </div>
                <div t-elif="link_error == 'no-fallback'" class="alert alert-warning" role="alert">
                    Telegram is the only way to sign in to this account, so it cannot be unlinked.
                </div>
                <div t-elif="link_error == 'session'" class="alert alert-warning" role="alert">
                    Please finish linking from the browser where you started it.
                </div>
                <div t-elif="link_error" class="alert alert-danger" role="alert">
                    The Telegram data could not be verified. Please try again.
                </div>
                <div t-if="link_success == 'linked'" class="alert alert-success" role="status">
                    Your Telegram account is now linked.
                </div>
                <div t-elif="link_success == 'unlinked'" class="alert alert-success" role="status">
                    Your Telegram account has been unlinked.
                </div>
                <t t-if="telegram_uid">
                    <p>
                        <b t-esc="user_name"/> is linked to
                        <t t-if="telegram_username">Telegram account <b t-esc="'@%s' % telegram_username"/>.</t>
                        <t t-else="">Telegram account ID <b t-esc="telegram_uid"/>.</t>
                    </p>
                </t>
                <t t-elif="not no_credential">
                    <p class="text-muted">
                        Link a Telegram account to <b t-esc="user_name"/> to sign in with one click.
                    </p>
                </t>

                <!-- credential change: users with a password confirm it first -->
                <t t-if="needs_password">
                    <p class="text-muted small">Please confirm your password to change your Telegram link.</p>
                    <form action="/auth/telegram/link/verify" method="post" class="mb-3 mx-auto" style="max-width: 320px;">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="password" name="password" class="form-control mb-2" required="required"
                               autocomplete="current-password" placeholder="Password" aria-label="Password"/>
                        <button type="submit" class="btn btn-primary w-100">Confirm</button>
                    </form>
                </t>
                <!-- accounts without a password: prove possession of the linked Telegram account -->
                <t t-elif="needs_telegram">
                    <p class="text-muted small">
                        To change your Telegram link, first confirm it is you by logging in
                        with your current Telegram account again.
                    </p>
                    <a t-if="telegram_reauth_url" t-att-href="telegram_reauth_url" role="button"
                       class="btn text-white fw-bold my-3"
                       style="background-color: #54a9eb;">
                        <i class="fa fa-paper-plane me-2" role="img" aria-label="Telegram"/>Log in with Telegram again
                    </a>
                    <div t-elif="telegram_bot_username" class="d-flex justify-content-center my-3">
                        <script async="async"
                                src="https://telegram.org/js/telegram-widget.js?22"
                                t-att-data-telegram-login="telegram_bot_username"
                                data-size="large"
                                data-userpic="true"
                                t-att-data-auth-url="telegram_auth_url"
                                data-request-access="write"/>
                    </div>
                </t>
                <!-- neither a password nor a linked Telegram account: nothing to confirm with -->
                <t t-elif="no_credential">
                    <p class="text-muted small">
                        This account has no password and no linked Telegram account, so a Telegram
                        account cannot be linked from here.
                        <t t-if="can_set_password">Set a password first, then come back to this page.</t>
                        <t t-else="">Please ask an administrator to link your Telegram account.</t>
                    </p>
                    <a t-if="can_set_password" href="/web/reset_password" role="button"
                       class="btn btn-primary my-3">Set a password</a>
                </t>
                <t t-else="">
                    <t t-if="telegram_uid">
                        <form t-if="can_unlink" action="/auth/telegram/unlink" method="post" class="mb-3">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-secondary">Unlink Telegram account</button>
                        </form>
                        <p t-else="" class="text-muted small">
                            Telegram is the only way to sign in to this account, so it cannot be unlinked.
                        </p>
                        <p class="text-muted small">To switch to a different Telegram account, use the button below.</p>
                    </t>
                    <t t-if="telegram_login_url">
                        <a t-att-href="telegram_login_url" role="button"
                           class="btn text-white fw-bold my-3"
                           style="background-color: #54a9eb;">
                            <i class="fa fa-paper-plane me-2" role="img" aria-label="Telegram"/>Link with Telegram
                        </a>
                    </t>
                    <t t-elif="telegram_bot_username">
                        <div class="d-flex justify-content-center my-3">
                            <script async="async"
                                    src="https://telegram.org/js/telegram-widget.js?22"
                                    t-att-data-telegram-login="telegram_bot_username"
                                    data-size="large"
                                    data-userpic="true"
                                    t-att-data-auth-url="telegram_auth_url"
                                    data-request-access="write"/>
                        </div>
                    </t>
                </t>
                <div>
                    <a t-att-href="home_url" class="btn btn-link btn-sm">Back</a>
                </div>
            </div>
        </t>
    </template>

    <!-- Chat login: waiting page while the user confirms in the Telegram bot -->
    <template id="bot_login_page" name="Telegram Chat Login">
        <t t-call="web.login_layout">
            <div class="text-center o_auth_telegram_bot" t-att-data-needs-code="'1' if needs_code else None"
                 t-att-data-ended="'1' if ended_alert else None">
                <h5 class="mb-2">
                    <t t-if="is_link">Link with Telegram</t>
                    <t t-else="">Log in with Telegram</t>
                </h5>
                <div id="o_auth_telegram_steps" t-if="not ended_alert">
                    <p t-if="match_code" class="text-muted small mb-3">
                        1. Open Telegram &#8594; 2. Tap <b>Start</b> &#8594; 3. Tap <b>Yes, Login</b>
                        &#8594; 4. Type the code the bot sends you below
                    </p>
                    <p t-else="" class="text-muted small mb-3">
                        1. Open Telegram &#8594; 2. Tap <b>Start</b> &#8594; 3. Tap <b>Yes, Login</b>
                    </p>
                </div>
                <div id="o_auth_telegram_open" t-att-hidden="'hidden' if needs_code or ended_alert else None">
                    <a t-att-href="deeplink" target="_blank" rel="noopener" role="button"
                       class="btn w-100 text-white fw-bold mb-3"
                       style="background-color: #54a9eb;">
                        <i class="fa fa-paper-plane me-2" role="img" aria-label="Telegram"/>Open Telegram
                    </a>
                    <div t-if="qr_src" class="d-none d-md-block mb-3">
                        <img t-att-src="qr_src" alt="QR code" width="180" height="180"
                             class="border rounded p-1 bg-white"/>
                        <div class="text-muted small mt-1">or scan with your phone's camera</div>
                    </div>
                </div>
                <div id="o_auth_telegram_status" class="text-muted small" role="status"
                     t-att-hidden="'hidden' if needs_code or ended_alert else None">
                    <i class="fa fa-circle-o-notch fa-spin me-1" role="img" aria-label="Waiting"/>
                    Waiting for your confirmation in Telegram (@<t t-esc="bot_username"/>)&#8230;
                </div>
                <!-- one-time code shown by the bot after "Yes" (never sent to this page) -->
                <form id="o_auth_telegram_code" method="post" action="/auth/telegram/verify"
                      class="mx-auto mb-3" style="max-width: 320px;"
                      t-att-hidden="None if needs_code else 'hidden'">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <label for="o_auth_telegram_code_input" class="form-label small text-muted">
                        Type the one-time code the bot sent you in Telegram
                    </label>
                    <input id="o_auth_telegram_code_input" name="code" type="text" inputmode="numeric"
                           pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code"
                           class="form-control form-control-lg text-center mb-2" required="required"
                           placeholder="123456" aria-label="One-time code"/>
                    <div t-if="attempts_left" class="alert alert-danger py-2" role="alert">
                        Wrong code. <t t-esc="attempts_left"/> attempt(s) left.
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Continue</button>
                </form>
                <div id="o_auth_telegram_nomessage" class="alert alert-warning mt-3" hidden="hidden" role="alert">
                    Telegram could not be reached to send you the confirmation. Open Telegram and tap
                    <b>Start</b> again, or <a t-att-href="retry_url">try again</a>.
                </div>
                <!-- outcome alerts: shown by the status poll, or server-side (ended_alert) -->
                <div id="o_auth_telegram_cancelled" class="alert alert-warning mt-3" role="alert"
                     t-att-hidden="None if ended_alert == 'cancelled' else 'hidden'">
                    <t t-if="is_link">Linking cancelled in Telegram.</t>
                    <t t-else="">Login cancelled in Telegram.</t>
                    <a t-att-href="retry_url">Try again</a>
                </div>
                <div id="o_auth_telegram_wrong_code" class="alert alert-warning mt-3" role="alert"
                     t-att-hidden="None if ended_alert == 'wrong_code' else 'hidden'">
                    Too many wrong codes, this request was cancelled.
                    <a t-att-href="retry_url">Try again</a>
                </div>
                <div id="o_auth_telegram_conflict" class="alert alert-warning mt-3" role="alert"
                     t-att-hidden="None if ended_alert == 'conflict' else 'hidden'">
                    This link was opened by another Telegram account, so the request was cancelled.
                    <a t-att-href="retry_url">Try again</a>
                </div>
                <div id="o_auth_telegram_expired" class="alert alert-warning mt-3" role="alert"
                     t-att-hidden="None if ended_alert == 'expired' else 'hidden'">
                    This request has expired.
                    <a t-att-href="retry_url">Try again</a>
                </div>
                <div id="o_auth_telegram_done" class="alert alert-info mt-3" hidden="hidden" role="alert">
                    This request was already completed in another tab.
                    <a href="/web">Continue</a>
                </div>
                <div class="mt-3">
                    <a t-att-href="home_url" class="btn btn-link btn-sm">Back</a>
                </div>
            </div>
            <script type="text/javascript">
                (function () {
                    var root = document.querySelector('.o_auth_telegram_bot');
                    if (!root) { return; }
                    var statusEl = document.getElementById('o_auth_telegram_status');
                    var openEl = document.getElementById('o_auth_telegram_open');
                    var stepsEl = document.getElementById('o_auth_telegram_steps');
                    var formEl = document.getElementById('o_auth_telegram_code');
                    var noMessageEl = document.getElementById('o_auth_telegram_nomessage');
                    var codeShown = !!root.getAttribute('data-needs-code');
                    var delay = 2000;
                    if (root.getAttribute('data-ended')) {
                        // the request already ended (outcome rendered by the server): nothing to poll
                        return;
                    }
                    function show(id) {
                        // a finished request: the deep link / QR code must go with the spinner
                        statusEl.hidden = true;
                        noMessageEl.hidden = true;
                        openEl.hidden = true;
                        if (stepsEl) { stepsEl.hidden = true; }
                        document.getElementById(id).hidden = false;
                    }
                    function showCodeForm() {
                        if (codeShown) { return; }
                        codeShown = true;
                        statusEl.hidden = true;
                        noMessageEl.hidden = true;
                        openEl.hidden = true;
                        formEl.hidden = false;
                        var input = document.getElementById('o_auth_telegram_code_input');
                        if (input) { input.focus(); }
                    }
                    if (codeShown) {
                        var input = document.getElementById('o_auth_telegram_code_input');
                        if (input) { input.focus(); }
                    }
                    function poll() {
                        // the request is identified by this browser's session cookie
                        fetch('/auth/telegram/status', {
                            credentials: 'same-origin', cache: 'no-store',
                        }).then(function (r) { return r.json(); }).then(function (data) {
                            if (data.state === 'confirmed') {
                                if (data.needs_code) {
                                    showCodeForm();
                                    setTimeout(poll, delay * 5);
                                } else {
                                    window.location.href = '/auth/telegram/complete';
                                }
                            } else if (data.state === 'cancelled') {
                                if (data.reason === 'no_account') {
                                    // same message as the other login methods; retrying cannot help
                                    window.location.href = '/web/login?telegram_error=no-account';
                                } else if (data.reason === 'taken') {
                                    // link flow: the link page has its own message
                                    window.location.href = '/auth/telegram/link?error=taken';
                                } else {
                                    formEl.hidden = true;
                                    show({
                                        wrong_code: 'o_auth_telegram_wrong_code',
                                        conflict: 'o_auth_telegram_conflict',
                                        stale: 'o_auth_telegram_expired',
                                    }[data.reason] || 'o_auth_telegram_cancelled');
                                }
                            } else if (data.state === 'done') {
                                var link = document.querySelector('#o_auth_telegram_done a');
                                if (link) { if (data.redirect) { link.href = data.redirect; } }
                                formEl.hidden = true;
                                show('o_auth_telegram_done');
                            } else if (data.state === 'expired' || data.state === 'invalid') {
                                formEl.hidden = true;
                                show('o_auth_telegram_expired');
                            } else {
                                // pending: tell the user when the bot could not send the prompt
                                var missing = !!data.prompt_missing;
                                noMessageEl.hidden = !missing;
                                statusEl.hidden = missing;
                                setTimeout(poll, delay);
                            }
                        }).catch(function () { setTimeout(poll, delay * 2); });
                    }
                    setTimeout(poll, delay);
                })();
            </script>
        </t>
    </template>

    <!-- "Open website" button of the Telegram success message: the secret is in
         the URL fragment (never sent to the server); this page posts it -->
    <template id="open_site_page" name="Telegram Open Website">
        <t t-call="web.login_layout">
            <div class="text-center o_auth_telegram_open_site">
                <form id="o_auth_telegram_open_form" method="post" action="/auth/telegram/open/confirm"
                      class="mx-auto" style="max-width: 320px;">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="key" id="o_auth_telegram_open_key"/>
                    <p class="text-muted">
                        <i class="fa fa-circle-o-notch fa-spin me-1" role="img" aria-label="Signing in"/>
                        Signing you in&#8230;
                    </p>
                    <button type="submit" class="btn btn-primary w-100">Continue</button>
                </form>
                <div id="o_auth_telegram_open_missing" class="alert alert-warning" hidden="hidden" role="alert">
                    This link is incomplete. Please tap the button in Telegram again, or log in.
                </div>
                <div class="mt-3">
                    <a href="/web/login" class="btn btn-link btn-sm">Log in</a>
                </div>
            </div>
            <script type="text/javascript">
                (function () {
                    var form = document.getElementById('o_auth_telegram_open_form');
                    if (!form) { return; }
                    var key = window.location.hash ? window.location.hash.substring(1) : '';
                    // drop the secret from the address bar and the history
                    if (window.history) {
                        if (window.history.replaceState) {
                            window.history.replaceState(null, '', window.location.pathname);
                        }
                    }
                    if (!key) {
                        form.hidden = true;
                        document.getElementById('o_auth_telegram_open_missing').hidden = false;
                        return;
                    }
                    document.getElementById('o_auth_telegram_open_key').value = key;
                    form.submit();
                })();
            </script>
        </t>
    </template>

</odoo>
