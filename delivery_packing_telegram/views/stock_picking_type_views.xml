<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_type_form_inherit_delivery_packing_telegram" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.delivery.packing.telegram</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <group name="auto_print" position="after">
                <group string="Telegram Packing Notification" invisible="code != 'outgoing'">
                    <field name="telegram_group_id" placeholder="e.g. -1001234567890"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
