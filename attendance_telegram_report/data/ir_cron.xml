<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Scheduled action times are stored in UTC. 11:30 UTC = 18:30 Indochina
        Time (UTC+7). If your company is on a different timezone, edit the
        "Next Execution Date" under Settings > Technical > Scheduled Actions.
    -->
    <record id="ir_cron_daily_telegram_attendance_report" model="ir.cron">
        <field name="name">Send Daily Attendance Report via Telegram</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_daily_telegram_attendance_report()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="'2024-01-01 11:30:00'"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="active">True</field>
    </record>

</odoo>
