  function decode(s){var d=document.createElement('textarea');d.innerHTML=s;return d.value;}

  var grid=document.getElementById('abj-pgrid');
  function buildGrid(){
    if(!grid){return;}
    grid.innerHTML='';
    IDS.forEach(function(id){
      var a=document.createElement('a');
      a.className='p-card rv in';
      a.href='/shop/'+SLUGS[id]+'-'+id;
      a.setAttribute('aria-label','Buy ABJ '+NAMES_EN[id]);
      if(BADGES[id]){
        var bd=document.createElement('span');
        bd.className='p-badge'+(BADGES[id][1]?' '+BADGES[id][1]:'');
        bd.textContent=BADGES[id][0];
        a.appendChild(bd);
      }
      var im=document.createElement('span');im.className='p-im';
      var img=document.createElement('img');
      img.src='/web/image/product.template/'+id+'/image_512';
      img.alt='ABJ '+NAMES_EN[id];
      img.loading='lazy';
      im.appendChild(img);a.appendChild(im);
      var body=document.createElement('span');body.className='p-body';
      var nm=document.createElement('span');nm.className='p-name';
      nm.textContent=KM?decode(NAMES_KM[id]):NAMES_EN[id];
      body.appendChild(nm);
      var ds=document.createElement('span');ds.className='p-desc';
      ds.textContent=KM?decode(DESCS_KM[id]):DESCS_EN[id];
      body.appendChild(ds);
      var row=document.createElement('span');row.className='p-row';
      var pr=document.createElement('span');pr.className='p-price';pr.textContent=PRICES[id];
      var bu=document.createElement('span');bu.className='p-buy';bu.textContent=KM?decode('&#x1791;&#x17B7;&#x1789;&#x17A5;&#x17A1;&#x17BC;&#x179C;'):'Buy now';
      row.appendChild(pr);row.appendChild(bu);
      body.appendChild(row);
      a.appendChild(body);
      grid.appendChild(a);
    });
  }
  buildGrid();

  /* --- hero video fallback --- */
  var v=document.getElementById('abj-hero-vid');
  if(v){
    var swapped=false;
    function swap(){
      if(swapped){return;}
      swapped=true;
      var fb=v.getAttribute('data-fallback');
      if(fb){v.src=fb;v.load();var p=v.play();if(p){p.catch(function(){});}}
    }
    v.addEventListener('error',swap);
    setTimeout(function(){if(2>v.readyState){swap();}},4000);
    var p0=v.play();if(p0){p0.catch(function(){});}
  }

  /* --- reveal on scroll --- */
  var rvEls=Array.prototype.slice.call(document.querySelectorAll('#abj-home .rv'));
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target);}
      });
    },{threshold:.12,rootMargin:'0px 0px -40px 0px'});
    rvEls.forEach(function(el){io.observe(el);});
  }else{
    rvEls.forEach(function(el){el.classList.add('in');});
  }
})();
