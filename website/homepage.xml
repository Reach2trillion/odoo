  <t t-call="website.layout">
    <div id="wrap" class="oe_structure oe_empty">

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400..700');
@import url('https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@400;500;600;700&amp;display=swap');

:root{
  --abj-blue:#2E86C8;
  --abj-blue-2:#3FA7E0;
  --abj-deep:#0B3D5C;
  --abj-bg:#F4FAFE;
  --abj-ink:#12303F;
  --abj-line:#DCEFFA;
}
#wrapwrap > main{background:var(--abj-bg)}
#abj-home{font-family:'Inter Tight','Inter',system-ui,sans-serif;color:var(--abj-ink);overflow-x:clip}
#abj-home img{max-width:100%}
#abj-home .wrap{max-width:1200px;margin:0 auto;padding:0 16px}
#abj-home h1,#abj-home h2,#abj-home h3{color:var(--abj-deep);font-family:inherit}
#abj-home .btn-abj{display:inline-flex;align-items:center;gap:8px;background:var(--abj-blue);color:#fff;border:0;border-radius:999px;padding:13px 26px;font-weight:600;font-size:15px;text-decoration:none;transition:background .2s ease,transform .2s ease}
#abj-home .btn-abj:hover{background:var(--abj-deep);color:#fff;transform:translateY(-1px)}
#abj-home .btn-ghost{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.92);color:var(--abj-deep);border:1px solid var(--abj-line);border-radius:999px;padding:13px 26px;font-weight:600;font-size:15px;text-decoration:none;transition:background .2s ease}
#abj-home .btn-ghost:hover{background:#fff;color:var(--abj-blue)}

/* reveal on scroll */
#abj-home .rv{opacity:0;transform:translateY(18px);transition:opacity .6s cubic-bezier(.22,1,.36,1),transform .6s cubic-bezier(.22,1,.36,1)}
#abj-home .rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){#abj-home .rv{opacity:1;transform:none;transition:none}}

/* promo bar */
#abj-promo{background:var(--abj-deep);color:#fff;font-size:13px}
#abj-promo .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:8px;padding-bottom:8px}
#abj-promo .msg{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#abj-promo a{color:#fff;text-decoration:none;font-weight:600}
#abj-lang{display:flex;gap:4px;flex:none}
#abj-lang button{background:transparent;border:1px solid rgba(255,255,255,.4);color:#fff;border-radius:999px;font-size:11px;padding:2px 10px;cursor:pointer}
#abj-lang button.on{background:#fff;color:var(--abj-deep);border-color:#fff}

/* hero */
#abj-hero{position:relative;overflow:hidden;background:var(--abj-deep)}
#abj-hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.85}
#abj-hero .shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(6,36,54,.82) 0%,rgba(6,36,54,.55) 45%,rgba(6,36,54,.15) 100%)}
#abj-hero .wrap{position:relative;z-index:2;padding-top:88px;padding-bottom:88px}
@media (min-width:768px){#abj-hero .wrap{padding-top:130px;padding-bottom:130px}}
#abj-hero .eyebrow{color:#BFE3F7;font-size:12px;letter-spacing:.22em;text-transform:uppercase;font-weight:600;margin-bottom:14px}
#abj-hero h1{color:#fff;font-size:clamp(34px,6vw,62px);line-height:1.06;letter-spacing:-.02em;font-weight:700;margin:0 0 16px;max-width:14ch}
#abj-hero p.sub{color:#DCEFFA;font-size:clamp(15px,2vw,18px);line-height:1.6;max-width:46ch;margin:0 0 26px}
#abj-hero .ctas{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:30px}
#abj-hero .marks{display:flex;flex-wrap:wrap;gap:10px 22px;color:#BFE3F7;font-size:12.5px;font-weight:600;letter-spacing:.04em}
#abj-hero .marks span{display:inline-flex;align-items:center;gap:7px}
#abj-hero .marks svg{flex:none}

/* trust strip */
#abj-trust{background:#fff;border-bottom:1px solid var(--abj-line)}
#abj-trust .wrap{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;padding-top:22px;padding-bottom:22px}
@media (min-width:900px){#abj-trust .wrap{grid-template-columns:repeat(4,1fr)}}
.tr-item{display:flex;align-items:center;gap:12px}
.tr-item svg{flex:none;color:var(--abj-blue)}
.tr-item b{display:block;font-size:14px;color:var(--abj-deep)}
.tr-item small{font-size:12.5px;color:#5B7A8C}

/* section heads */
.sec{padding:56px 0 8px}
.sec-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:26px}
.sec-head .eyebrow{color:var(--abj-blue);font-size:12px;letter-spacing:.2em;text-transform:uppercase;font-weight:700;margin-bottom:6px}
.sec-head h2{font-size:clamp(24px,3.6vw,36px);font-weight:700;letter-spacing:-.02em;margin:0}
.sec-head .more{flex:none;color:var(--abj-blue);font-weight:600;font-size:14px;text-decoration:none;white-space:nowrap}
.sec-head .more:hover{color:var(--abj-deep)}

/* category tiles */
#abj-cats .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;padding-bottom:26px}
@media (min-width:640px){#abj-cats .grid{grid-template-columns:repeat(3,1fr)}}
@media (min-width:1024px){#abj-cats .grid{grid-template-columns:repeat(6,1fr)}}
.cat-tile{background:#fff;border:1px solid var(--abj-line);border-radius:18px;padding:18px 12px 16px;text-align:center;text-decoration:none;transition:box-shadow .2s ease,transform .2s ease;display:block}
.cat-tile:hover{box-shadow:0 12px 30px rgba(46,134,200,.16);transform:translateY(-3px)}
.cat-tile .im{height:110px;display:flex;align-items:center;justify-content:center;margin-bottom:10px}
.cat-tile img{max-height:100%;object-fit:contain}
.cat-tile b{display:block;color:var(--abj-deep);font-size:14px;font-weight:600}
.cat-tile small{color:var(--abj-blue);font-size:12px;font-weight:600}

/* product cards */
#abj-best .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;padding-bottom:30px}
@media (min-width:768px){#abj-best .grid{grid-template-columns:repeat(3,1fr);gap:18px}}
@media (min-width:1100px){#abj-best .grid{grid-template-columns:repeat(4,1fr)}}
.p-card{position:relative;background:#fff;border:1px solid var(--abj-line);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;text-decoration:none;transition:box-shadow .2s ease,transform .2s ease}
.p-card:hover{box-shadow:0 16px 38px rgba(46,134,200,.18);transform:translateY(-4px)}
.p-badge{position:absolute;top:12px;left:12px;z-index:2;background:var(--abj-blue);color:#fff;font-size:10.5px;font-weight:700;letter-spacing:.08em;border-radius:999px;padding:4px 10px}
.p-badge.hot{background:#E5327E}
.p-im{background:linear-gradient(180deg,#EAF6FE 0%,#fff 100%);aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;padding:14%}
.p-im img{max-height:100%;object-fit:contain;transition:transform .3s ease}
.p-card:hover .p-im img{transform:scale(1.05)}
.p-body{padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1}
.p-name{color:var(--abj-deep);font-weight:600;font-size:15px;line-height:1.3}
.p-desc{color:#5B7A8C;font-size:12.5px;line-height:1.5;flex:1}
.p-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:6px}
.p-price{color:var(--abj-deep);font-weight:700;font-size:17px}
.p-buy{background:var(--abj-blue);color:#fff;font-size:12.5px;font-weight:600;border-radius:999px;padding:8px 16px;transition:background .2s ease}
.p-card:hover .p-buy{background:var(--abj-deep)}

/* promo band */
#abj-band{background:linear-gradient(120deg,var(--abj-blue) 0%,var(--abj-blue-2) 100%);color:#fff;margin:48px 0 0}
#abj-band .wrap{display:grid;gap:34px;padding-top:56px;padding-bottom:56px}
@media (min-width:900px){#abj-band .wrap{grid-template-columns:1.2fr 1fr;align-items:center}}
#abj-band h2{color:#fff;font-size:clamp(26px,3.6vw,40px);font-weight:700;letter-spacing:-.02em;margin:0 0 12px}
#abj-band p{color:#EAF6FE;font-size:15.5px;line-height:1.65;max-width:52ch;margin:0 0 22px}
#abj-band .btn-abj{background:#fff;color:var(--abj-deep)}
#abj-band .btn-abj:hover{background:var(--abj-deep);color:#fff}
.band-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.band-stats div{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);border-radius:16px;padding:18px 14px;text-align:center}
.band-stats b{display:block;font-size:clamp(22px,3vw,30px);font-weight:700}
.band-stats span{font-size:12px;letter-spacing:.06em;text-transform:uppercase;opacity:.9}

/* testimonials */
#abj-quotes .grid{display:grid;gap:14px;padding-bottom:30px}
@media (min-width:900px){#abj-quotes .grid{grid-template-columns:repeat(3,1fr);gap:18px}}
.q-card{background:#fff;border:1px solid var(--abj-line);border-radius:20px;padding:22px 20px}
.q-stars{color:#F5A623;letter-spacing:2px;font-size:14px;margin-bottom:10px}
.q-card p{color:var(--abj-ink);font-size:14px;line-height:1.65;margin:0 0 14px}
.q-card b{color:var(--abj-deep);font-size:13px;font-weight:600}
.q-card small{display:block;color:#5B7A8C;font-size:12px}

/* outro CTA */
#abj-outro{padding:26px 0 70px}
#abj-outro .card{background:#fff;border:1px solid var(--abj-line);border-radius:24px;padding:38px 26px;text-align:center}
#abj-outro h2{font-size:clamp(24px,3.4vw,34px);margin:0 0 10px}
#abj-outro p{color:#5B7A8C;font-size:15px;max-width:52ch;margin:0 auto 22px;line-height:1.6}
#abj-outro .ctas{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}

/* floating call button */
#abj-call{position:fixed;right:18px;bottom:18px;z-index:60;width:54px;height:54px;border-radius:50%;background:var(--abj-blue);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 26px rgba(11,61,92,.35);transition:transform .2s ease,background .2s ease}
#abj-call:hover{transform:scale(1.07);background:var(--abj-deep);color:#fff}

/* --- Khmer language (auto on /km routes) --- */
.lk{display:none !important;font-family:'Kantumruy Pro','Noto Sans Khmer',system-ui,sans-serif;letter-spacing:0}
html.abj-km .lk{display:revert !important}
html.abj-km .le{display:none !important}
html.abj-km #abj-home .p-desc,html.abj-km #abj-home .p-name,html.abj-km #abj-home p,html.abj-km #abj-home h1,html.abj-km #abj-home h2,html.abj-km #abj-home h3,html.abj-km #abj-home b,html.abj-km #abj-home small{font-family:'Kantumruy Pro','Noto Sans Khmer',system-ui,sans-serif;letter-spacing:.01em}
html.abj-km #abj-hero h1{line-height:1.25;max-width:none}
html.abj-km #abj-hero p.sub{line-height:1.8}
</style>

