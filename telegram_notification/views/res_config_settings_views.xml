<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.telegram.notification</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="75"/>
        <field name="inherit_id" ref="auth_telegram.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='auth_telegram']" position="inside">
                <div class="content-group mt16">
                    <div class="text-muted mb8">Send a Telegram message to linked customers when:</div>
                    <div class="mt4">
                        <field name="telegram_notify_quotation" class="me-2"/>
                        <label for="telegram_notify_quotation"/>
                    </div>
                    <div class="mt4">
                        <field name="telegram_notify_order" class="me-2"/>
                        <label for="telegram_notify_order"/>
                    </div>
                    <div class="mt4">
                        <field name="telegram_notify_delivery" class="me-2"/>
                        <label for="telegram_notify_delivery"/>
                    </div>
                    <div class="mt4">
                        <field name="telegram_notify_invoice" class="me-2"/>
                        <label for="telegram_notify_invoice"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
