<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_telegram" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.telegram.notification</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="after">
                <field name="telegram_link" string="Telegram" widget="url" invisible="not telegram_link"/>
            </xpath>
        </field>
    </record>

</odoo>
